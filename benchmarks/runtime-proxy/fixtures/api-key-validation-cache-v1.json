{
  "schemaVersion": 1,
  "policy": {
    "ttlMs": 60000,
    "maxEntries": 1000,
    "evictEntries": 200
  },
  "expiryParseCases": [
    { "name": "date-only-epoch-is-utc", "value": "1970-01-01", "expectedEpochMs": 0 },
    { "name": "date-only-next-day", "value": "1970-01-02", "expectedEpochMs": 86400000 },
    {
      "name": "positive-offset-is-subtracted-from-local-clock",
      "value": "1970-01-01T05:30:10+05:30",
      "expectedEpochMs": 10000
    },
    {
      "name": "negative-offset-is-added-to-local-clock",
      "value": "1970-01-01T02:00:10-02:00",
      "expectedEpochMs": 14410000
    },
    {
      "name": "offset-and-fraction-preserve-millisecond-boundary",
      "value": "1970-01-01T05:30:10.001+05:30",
      "expectedEpochMs": 10001
    },
    {
      "name": "invalid-offset-is-unparsed",
      "value": "1970-01-01T00:00:10.000+24:00",
      "expectedEpochMs": null
    }
  ],
  "vectors": [
    {
      "name": "positive-only-and-strict-ttl",
      "actions": [
        { "op": "seed-key", "key": "negative-then-positive", "valid": false },
        {
          "op": "validate",
          "key": "negative-then-positive",
          "atMs": 1000,
          "expected": false
        },
        {
          "op": "set-authoritative-validity",
          "key": "negative-then-positive",
          "valid": true
        },
        {
          "op": "validate",
          "key": "negative-then-positive",
          "atMs": 1001,
          "expected": true
        },
        { "op": "seed-key", "key": "ttl-boundary", "valid": true },
        { "op": "validate", "key": "ttl-boundary", "atMs": 5000, "expected": true },
        {
          "op": "set-authoritative-validity",
          "key": "ttl-boundary",
          "valid": false
        },
        { "op": "validate", "key": "ttl-boundary", "atMs": 64999, "expected": true },
        { "op": "validate", "key": "ttl-boundary", "atMs": 65000, "expected": false }
      ]
    },
    {
      "name": "local-write-and-revoke-invalidation",
      "actions": [
        { "op": "seed-key", "key": "write-invalidates", "valid": true },
        { "op": "validate", "key": "write-invalidates", "atMs": 10000, "expected": true },
        { "op": "write-invalidate", "key": "write-invalidates", "valid": false },
        { "op": "validate", "key": "write-invalidates", "atMs": 10001, "expected": false },
        { "op": "seed-key", "key": "revoke-invalidates", "valid": true },
        { "op": "validate", "key": "revoke-invalidates", "atMs": 20000, "expected": true },
        { "op": "revoke", "key": "revoke-invalidates" },
        { "op": "validate", "key": "revoke-invalidates", "atMs": 20001, "expected": false }
      ]
    },
    {
      "name": "insertion-order-eviction-does-not-refresh-on-hit",
      "actions": [
        {
          "op": "seed-valid-range",
          "prefix": "evict-",
          "start": 0,
          "endInclusive": 999
        },
        { "op": "seed-key", "key": "evict-1000", "valid": true },
        { "op": "seed-key", "key": "evict-1001", "valid": true },
        {
          "op": "validate-range",
          "prefix": "evict-",
          "start": 0,
          "endInclusive": 999,
          "atMs": 30000
        },
        { "op": "validate", "key": "evict-0", "atMs": 30001, "expected": true },
        { "op": "set-authoritative-validity", "key": "evict-0", "valid": false },
        { "op": "set-authoritative-validity", "key": "evict-199", "valid": false },
        { "op": "set-authoritative-validity", "key": "evict-200", "valid": false },
        { "op": "validate", "key": "evict-1000", "atMs": 30002, "expected": true },
        { "op": "validate", "key": "evict-1001", "atMs": 30003, "expected": true },
        { "op": "validate", "key": "evict-0", "atMs": 30004, "expected": false },
        { "op": "validate", "key": "evict-199", "atMs": 30005, "expected": false },
        { "op": "validate", "key": "evict-200", "atMs": 30006, "expected": true },
        { "op": "validate", "key": "evict-999", "atMs": 30007, "expected": true },
        { "op": "validate", "key": "evict-1000", "atMs": 30008, "expected": true },
        { "op": "validate", "key": "evict-1001", "atMs": 30009, "expected": true }
      ]
    }
  ],
  "lifecycleCases": [
    {
      "name": "inactive-key-is-denied",
      "key": "lifecycle-inactive",
      "isActive": 0,
      "isBanned": 0,
      "revokedAt": null,
      "expiresAt": null,
      "checks": [{ "nowMs": 10000, "expected": false }]
    },
    {
      "name": "banned-key-is-denied",
      "key": "lifecycle-banned",
      "isActive": 1,
      "isBanned": 1,
      "revokedAt": null,
      "expiresAt": null,
      "checks": [{ "nowMs": 10000, "expected": false }]
    },
    {
      "name": "revoked-key-is-denied",
      "key": "lifecycle-revoked",
      "isActive": 1,
      "isBanned": 0,
      "revokedAt": "2026-10-10T00:00:00.000Z",
      "expiresAt": null,
      "checks": [{ "nowMs": 10000, "expected": false }]
    },
    {
      "name": "blank-revocation-timestamp-is-not-revoked",
      "key": "lifecycle-blank-revocation",
      "isActive": 1,
      "isBanned": 0,
      "revokedAt": "  ",
      "expiresAt": null,
      "checks": [{ "nowMs": 10000, "expected": true }]
    },
    {
      "name": "expiry-at-current-time-is-denied",
      "key": "lifecycle-expiry-boundary",
      "isActive": 1,
      "isBanned": 0,
      "revokedAt": null,
      "expiresAt": "1970-01-01T00:00:10.000Z",
      "checks": [{ "nowMs": 10000, "expected": false }]
    },
    {
      "name": "expiry-one-millisecond-in-future-is-allowed",
      "key": "lifecycle-future-expiry",
      "isActive": 1,
      "isBanned": 0,
      "revokedAt": null,
      "expiresAt": "1970-01-01T00:00:10.001Z",
      "checks": [
        { "nowMs": 10000, "expected": true },
        { "nowMs": 10001, "expected": true },
        { "nowMs": 70000, "expected": false }
      ]
    },
    {
      "name": "date-only-expiry-is-utc-midnight",
      "key": "lifecycle-date-only-expiry",
      "isActive": 1,
      "isBanned": 0,
      "revokedAt": null,
      "expiresAt": "1970-01-02",
      "checks": [
        { "nowMs": 0, "expected": true },
        { "nowMs": 86400000, "expected": false }
      ]
    },
    {
      "name": "offset-expiry-at-current-time-is-denied",
      "key": "lifecycle-offset-expiry-boundary",
      "isActive": 1,
      "isBanned": 0,
      "revokedAt": null,
      "expiresAt": "1970-01-01T05:30:10+05:30",
      "checks": [{ "nowMs": 10000, "expected": false }]
    },
    {
      "name": "fractional-offset-expiry-one-millisecond-ahead-is-allowed",
      "key": "lifecycle-offset-future-expiry",
      "isActive": 1,
      "isBanned": 0,
      "revokedAt": null,
      "expiresAt": "1970-01-01T05:30:10.001+05:30",
      "checks": [{ "nowMs": 10000, "expected": true }]
    },
    {
      "name": "invalid-expiry-is-ignored-by-date-parse-gate",
      "key": "lifecycle-invalid-expiry",
      "isActive": 1,
      "isBanned": 0,
      "revokedAt": null,
      "expiresAt": "not-a-date",
      "checks": [{ "nowMs": 10000, "expected": true }]
    }
  ]
}
