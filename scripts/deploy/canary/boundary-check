#!/usr/bin/python3 -I
"""Fixed root-installed entry; refuses checkout execution before importing helpers."""
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import stat
import sys


def refused():
    print('{"protocol":1,"ok":false,"category":"canary-host-installation-refused"}')
    sys.exit(1)


root = Path("/opt/omni-local-next/canary-host")
if Path(__file__).resolve() != root / ("boundary-check" if Path(__file__).name == "boundary-check" else "adapter") or os.geteuid() != 0:
    refused()


def safe(path, private=False):
    for ancestor in (path, *path.parents):
        s = ancestor.lstat()
        if s.st_uid != 0 or s.st_mode & 0o022 or stat.S_ISLNK(s.st_mode):
            refused()
    s = path.lstat()
    if not stat.S_ISREG(s.st_mode) or s.st_nlink != 1 or s.st_size > 1048576 or (private and s.st_mode & 0o077):
        refused()


try:
    policy = Path("/etc/omni-local-next/canary/layout.json")
    safe(policy, True)
    layout = json.loads(policy.read_bytes())
    files = {name: root / name for name in ("__init__.py", "adapter.py", "controller.py", "host.py", "proxy.py", "readiness.py", "runtime.py", "boundary.py")}
    if layout.get("schema") == 2:
        for name in ("conversation.py", "sharedApp.py", "sharedAppHost.py", "schemaProof.py", "sharedPaths.py", "wanRequester.py", "frontdoor.py", "static_assets.py"):
            files[name] = root / name
    files["runtime_launcher.py"] = Path("/opt/omni-local-next/runtime/runtime_launcher.py")
    if set(layout["implementationHashes"]) != set(files):
        refused()
    for name, path in files.items():
        safe(path)
        if hashlib.sha256(path.read_bytes()).hexdigest() != layout["implementationHashes"][name]:
            refused()
    spec = importlib.util.spec_from_file_location("omni_canary", root / "__init__.py", submodule_search_locations=[str(root)])
    package = importlib.util.module_from_spec(spec)
    sys.modules["omni_canary"] = package
    spec.loader.exec_module(package)
    if Path(__file__).name == "boundary-check":
        from omni_canary.boundary import main
    else:
        from omni_canary.adapter import main
    main()
except (Exception,):
    refused()
